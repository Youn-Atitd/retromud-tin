#EVENT {SESSION CONNECTED} {
    #screen rescale 2000 3000;
    #VARIABLE {my[target]} {monster};
    @_screen_update{};
};

#nop {Run after login when the game prompt appears - not at the login screen}
#ACTION {^Hp: %d}
{
    #IF {$loggedin == 0}
    {
        #VAR {loggedin} {1};
        wear all EQ;
        keep all EQ;
    };
};

#var {AUTO[eat]} {0};
#var {AUTO[drink]} {0};
#var {loggedin} {0};

#alias {set auto eat}
{
    #if {$AUTO[eat]}
    {
        WarningMessage Disabling Auto Eat and Drink...;
        #var AUTO[eat] 0;
        #var AUTO[drink] 0;
    };
    #else
    {
        InfoMessage Enabling Auto Eat and Drink...;
        #var AUTO[eat] 1;
        #var AUTO[drink] 1;
    };
}
