{
    #RETURN {#NOP};
};

#FUNCTION {_pause}
{
    #RETURN {#NOP};
};

#FUNCTION {comm_window_scroll_up}
{
    #RETURN {#NOP};
};

#FUNCTION {comm_window_scroll_down}
{
    #RETURN {#NOP};
};

#ALIAS {bot}
{
    #SEND {%0};
};

#ALIAS {ex}
{
    #SEND {exits};
};

#class util close;
