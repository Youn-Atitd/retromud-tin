#class util open;

#FUNCTION {InfoMessage}
{
    #SHOWME {<020>%0<088>};
    #RETURN {#NOP};
};

#FUNCTION {WarningMessage}
{
    #SHOWME {<110>%0<088>};
    #RETURN {#NOP};
};

